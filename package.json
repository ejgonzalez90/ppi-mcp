    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
