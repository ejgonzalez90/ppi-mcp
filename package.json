{
  "name": "ppi-mcp",
  "version": "1.0.0",
  "description": "MCP server for PPI (Portfolio Personal Inversiones) REST API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejgonzalez90/ppi-mcp.git"
  },
  "homepage": "https://github.com/ejgonzalez90/ppi-mcp",
  "type": "module",
  "bin": {
    "ppi-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "prettier:fix": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
