# PPI API credentials (required)
# Obtain these from your PPI client portal or API access request
PPI_API_KEY=your_api_key_here
PPI_API_SECRET=your_api_secret_here
PPI_AUTHORIZED_CLIENT=your_authorized_client_id
PPI_CLIENT_KEY=your_client_key_here

# Optional overrides
# PPI_BASE_URL=https://clientapi_sandbox.portfoliopersonal.com   # default: sandbox
# PPI_API_VERSION=1.0                                            # default: 1.0
