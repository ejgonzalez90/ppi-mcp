{
  "version": "2.0.0",
  "tasks": [
    // ── Build ───────────────────────────────────────────────────────────────
    {
      "label": "Build: production image",
      "type": "shell",
      "command": "docker build --target runtime -t ppi-mcp:latest .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "build"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: dev image",
      "type": "shell",
      "command": "docker build --target dev -t ppi-mcp:dev .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "build"
      },
      "problemMatcher": []
    },
    // ── Run ─────────────────────────────────────────────────────────────────
    {
      "label": "Run: production",
      "type": "shell",
      "command": "docker run -i --rm --env-file .env -p 127.0.0.1:7575:7575 ppi-mcp:latest",
      "dependsOn": "Build: production image",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "run"
      },
      "problemMatcher": []
    },
    // ── Dev / Hot Reload ─────────────────────────────────────────────────────
    // Rebuilds the dev image (picks up package.json changes), then starts the
    // container with src/ volume-mounted. tsx watch restarts the process on
    // every .ts save — no image rebuild needed for source changes.
    {
      "label": "Dev: hot reload",
      "dependsOn": "Build: dev image",
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "docker run -i --rm --env-file .env -p 127.0.0.1:7575:7575 -v \"${workspaceFolder}/src:/app/src\" ppi-mcp:dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "run"
      },
      "problemMatcher": []
    },
    // ── Compose / Test ───────────────────────────────────────────────────────
    {
      "label": "Compose: up (build + detach)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "run"
      },
      "problemMatcher": []
    },
    {
      "label": "Test: unit tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "test"
      },
      "problemMatcher": []
    }
  ]
}
